{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": "./src",
    "paths": {
      "@/types": ["./types/index"],
      "@/mappers/*": ["./mappers/*"],
      "@/clients/*": ["./clients/*"],
      "@/routes/*": ["./routes/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}